local KFSec = Section(CombatTab, "Öldürme Kaydı")
local killFeedFrame = Instance.new("ScrollingFrame")
killFeedFrame.Size = UDim2.new(1, 0, 0, 140)
killFeedFrame.BackgroundColor3 = Color3.fromRGB(6, 6, 10)
killFeedFrame.BorderSizePixel = 0
killFeedFrame.ScrollBarThickness = 3
killFeedFrame.ScrollBarImageColor3 = Theme.Accent
killFeedFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
killFeedFrame.Parent = KFSec
Instance.new("UICorner", killFeedFrame).CornerRadius = UDim.new(0, 5)
local killFeedLayout = Instance.new("UIListLayout")
killFeedLayout.SortOrder = Enum.SortOrder.LayoutOrder
killFeedLayout.Padding = UDim.new(0, 2)
killFeedLayout.Parent = killFeedFrame
killFeedLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    killFeedFrame.CanvasSize = UDim2.new(0, 0, 0, killFeedLayout.AbsoluteContentSize.Y + 6)
end)
local function PushKillFeed(text)
    if not CFG.KillFeed then return end
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -8, 0, 16)
    l.BackgroundTransparency = 1
    l.Text = "[" .. os.date("%H:%M:%S") .. "] " .. text
    l.TextColor3 = Color3.fromRGB(255, 130, 130)
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Font = Enum.Font.Code
    l.TextSize = 10
    l.TextTruncate = Enum.TextTruncate.AtEnd
    l.Parent = killFeedFrame
    killFeedFrame.CanvasPosition = Vector2.new(0, killFeedLayout.AbsoluteContentSize.Y)
    task.delay(60, function() if l.Parent then l:Destroy() end end)
end
Button(KFSec, "kaydı temizle", function()
    for _, c in ipairs(killFeedFrame:GetChildren()) do
        if c:IsA("TextLabel") then c:Destroy() end
    end
end)
task.spawn(function()
    local function hookPlayer(p)
        p.CharacterAdded:Connect(function(c)
            local h = c:WaitForChild("Humanoid", 5)
            if h then
                h.Died:Connect(function()
                    local creator = h:FindFirstChild("creator")
                    if creator and creator.Value then
                        PushKillFeed(p.Name .. " <- " .. creator.Value.Name)
                    else
                        PushKillFeed(p.Name .. " öldü")
                    end
                end)
            end
        end)
    end
    for _, p in ipairs(Players:GetPlayers()) do hookPlayer(p) end
    Players.PlayerAdded:Connect(hookPlayer)
end)
end

