local function PlaySoundId(soundId, name)
    StopMusic()
    if not soundId or soundId == "" then
        Log("geçersiz ses id")
        return
    end
    if not soundId:find("rbxassetid://") and not soundId:find("rbxasset") and not soundId:find("http") then
        if tonumber(soundId) then soundId = "rbxassetid://" .. soundId end
    end
    if CFG.MuteGame then SetGameMuted(true) end
    local s = Instance.new("Sound")
    s.Name = "XAXA_Music_" .. math.random(1, 1e6)
    s.SoundId = soundId
    s.Volume = math.max(CFG.MusicVolume, 1)
    s.Looped = CFG.MusicLooped
    s.Parent = SoundService
    CurrentMusic = s
    CFG.MusicCurrentName = name or soundId
    local loaded = false
    local function tryPlay()
        if loaded or not s.Parent then return end
        loaded = true
        local ok = pcall(function() s:Play() end)
        if ok and s.IsPlaying then
            CFG.MusicPlaying = true
            Log("çalıyor: " .. (name or soundId))
        else
            Log("ses çalınamadı")
        end
    end
    if s.IsLoaded then
        tryPlay()
    else
        s.Loaded:Connect(tryPlay)
        task.delay(5, function()
            if not loaded then
                Log("ses yüklenemedi")
                pcall(function() s:Destroy() end)
                if CurrentMusic == s then
                    CurrentMusic = nil
                    CFG.MusicPlaying = false
                end
            end
        end)
    end
end

local function DownloadAndPlay(url, name)
    if not HAS_FS then
        Log("writefile/readfile yok")
        return
    end
    if not HAS_ASSET then
        Log("getcustomasset yok")
        return
    end
    if not url or not url:find("http") then
        Log("geçersiz url")
        return
    end
    local fname = "XAXA_" .. tostring(name or "music"):gsub("[^%w_]", "") .. ".mp3"
    if isfile and isfile(fname) then
        local valid = true
        pcall(function()
            local fdata = readfile(fname)
            if not fdata or #fdata < 100000 then valid = false end
        end)
        if valid then
            local asset
            pcall(function()
                if type(getcustomasset) == "function" then asset = getcustomasset(fname) end
                if not asset and type(getsynasset) == "function" then asset = getsynasset(fname) end
            end)
            if asset then
                PlaySoundId(asset, name or "cached")
                return
            end
        end
    end
    Spin(true)
    Log("indiriliyor: " .. (name or "müzik"))
    task.spawn(function()
        local ok, data = pcall(function() return game:HttpGet(url) end)
        if not ok or not data or #data < 100 then
            Spin(false)
            Log("indirme başarısız")
            return
        end
        pcall(function() writefile(fname, data) end)
        local aok, asset = pcall(function()
            if type(getcustomasset) == "function" then return getcustomasset(fname) end
            if type(getsynasset) == "function" then return getsynasset(fname) end
        end)
        Spin(false)
        if not aok or not asset then
            Log("asset oluşturulamadı")
            return
        end
        PlaySoundId(asset, name or "custom")
    end)
end

