local function handleChatCommand(msg)
    if not msg or msg == "" then return end
    if msg:sub(1, 1) ~= "@" then return end
    local args = {}
    for w in msg:gmatch("%S+") do table.insert(args, w) end
    local cmd = args[1]:lower():sub(2)
    if cmd == "bring" and args[2] then
        local p = GetPlr(args[2])
        if p and p.Character then
            local th = GetRoot(p.Character)
            local mh = GetRoot(LocalPlayer.Character)
            if th and mh then th.CFrame = mh.CFrame * CFrame.new(0, 0, 4) end
        end
    elseif cmd == "kill" and args[2] then
        local p = GetPlr(args[2])
        if p and p.Character then
            local h = GetHum(p.Character)
            if h then h.Health = 0 end
        end
    elseif cmd == "tp" and args[2] then
        local p = GetPlr(args[2])
        if p and p.Character then
            local th = GetRoot(p.Character)
            local mh = GetRoot(LocalPlayer.Character)
            if th and mh then mh.CFrame = th.CFrame * CFrame.new(0, 0, 4) end
        end
    elseif cmd == "tpto" then
        local mh = GetRoot(LocalPlayer.Character)
        local mouse = LocalPlayer:GetMouse()
        if mh and mouse.Hit then mh.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0)) end
    elseif cmd == "killall" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local h = GetHum(p.Character)
                if h then pcall(function() h.Health = 0 end) end
            end
        end
    elseif cmd == "bringall" then
        local mh = GetRoot(LocalPlayer.Character)
        if mh then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local th = GetRoot(p.Character)
                    if th then th.CFrame = mh.CFrame * CFrame.new(0, 0, 4) end
                end
            end
        end
    elseif cmd == "god" then
        local h = GetHum(LocalPlayer.Character)
        if h then h.MaxHealth = math.huge h.Health = math.huge end
    elseif cmd == "fly" then
        CFG.Fly = not CFG.Fly
        Save()
        Log("uçuş: " .. tostring(CFG.Fly))
    elseif cmd == "noclip" then
        CFG.Noclip = not CFG.Noclip
        Save()
        Log("noclip: " .. tostring(CFG.Noclip))
    elseif cmd == "esp" then
        CFG.ESP = not CFG.ESP
        Save()
        RefreshESP()
        Log("esp: " .. tostring(CFG.ESP))
    elseif cmd == "help" then
        Log("@bring @kill @tp @tpto @killall @bringall @god @fly @noclip @esp @help")
    end
end

