_G.XAXAUi.Destroy = function()
    pcall(function() gui:Destroy() end)
    pcall(function() CrosshairGui:Destroy() end)
    pcall(function() RadarGui:Destroy() end)
    pcall(function() HitMarkerGui:Destroy() end)
    pcall(function() SkinGui:Destroy() end)
    pcall(function() BlurFx:Destroy() end)
    if FlyBV then pcall(function() FlyBV:Destroy() end) end
    if FlyBG then pcall(function() FlyBG:Destroy() end) end
    if MevlanaBG then pcall(function() MevlanaBG:Destroy() end) end
    if FOVCircle and FOVCircle.Remove then pcall(function() FOVCircle:Remove() end) end
    for p, _ in pairs(ESPData) do RemoveESP(p) end
    for model, _ in pairs(NPCData) do RemoveNPCESP(model) end
    for obj, _ in pairs(ItemData) do RemoveItemESP(obj) end
    ClearAura()
    if BodyLight then pcall(function() BodyLight:Destroy() end) end
    if BodyTrail then pcall(function() BodyTrail:Destroy() end) end
    StopMusic()
    if CFG.MuteGame then SetGameMuted(false) end
    Save()
    _G.XAXAUi = nil
end

