UIS.InputChanged:Connect(function(input, gp)
    if gp then return end
    if not FreeLookActive then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        if not FreeLookRot then FreeLookRot = Camera.CFrame end
        local sens = 0.003 * CFG.FreeLookSens
        local delta = Vector2.new(input.Delta.X, input.Delta.Y) * sens
        local yaw = CFrame.Angles(0, -delta.X, 0)
