local MuteState = { active = false, saved = {} }

local function SetGameMuted(muted)
    if muted then
        if MuteState.active then return end
        MuteState.saved = {}
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("Sound") then
                MuteState.saved[v] = { vol = v.Volume, play = v.Playing }
                pcall(function() v.Volume = 0 end)
            elseif v:IsA("SoundGroup") then
                MuteState.saved[v] = { vol = v.Volume }
                pcall(function() v.Volume = 0 end)
            end
        end
        for _, v in ipairs(Lighting:GetDescendants()) do
            if v:IsA("Sound") then
                MuteState.saved[v] = { vol = v.Volume, play = v.Playing }
                pcall(function() v.Volume = 0 end)
            end
        end
        for _, v in ipairs(SoundService:GetDescendants()) do
            if v:IsA("Sound") and v ~= CurrentMusic then
                MuteState.saved[v] = { vol = v.Volume, play = v.Playing }
                pcall(function() v.Volume = 0 end)
            elseif v:IsA("SoundGroup") then
                MuteState.saved[v] = { vol = v.Volume }
                pcall(function() v.Volume = 0 end)
            end
        end
        MuteState.active = true
