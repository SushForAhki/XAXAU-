local function GetAimTarget()
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil end
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local bestPart, bestScore = nil, math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local skipTeam = CFG.AimTeamCheck and p.Team == LocalPlayer.Team
            if not skipTeam then
                local char = p.Character
                local hum = char:FindFirstChildOfClass("Humanoid")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hum and hrp and hum.Health > 0 then
                    local targetPart
                    if CFG.AimTargetPart == "Head" then
                        targetPart = char:FindFirstChild("Head")
                    else
                        targetPart = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("LowerTorso") or hrp
                    end
                    if targetPart then
                        local predictPos = targetPart.Position
                        if CFG.AimPrediction then
                            predictPos = predictPos + (hrp.Velocity * CFG.AimPredictionVal)
                        end
                        local sp, onScreen = Camera:WorldToViewportPoint(predictPos)
                        if onScreen and sp.Z > 0 then
                            local screenDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                            if screenDist <= CFG.AimFOV then
                                local visible = true
                                if CFG.AimWallCheck then
                                    local dir = (targetPart.Position - myHrp.Position).Unit
                                    local len = (targetPart.Position - myHrp.Position).Magnitude
                                    local hit = Ray(myHrp.Position, dir, len, { myChar })
                                    if hit and not hit.Instance:IsDescendantOf(char) then
                                        visible = false
                                    end
                                end
                                if visible and screenDist < bestScore then
                                    bestScore = screenDist
                                    bestPart = targetPart
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return bestPart
end

