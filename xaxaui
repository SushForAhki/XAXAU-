task.spawn(function()
    while StatBar.Parent do
        pcall(function()
            local active = {}
            if CFG.Fly then table.insert(active, "Uçuş") end
            if CFG.Speed then table.insert(active, "Hız") end
            if CFG.ESP then table.insert(active, "ESP") end
            if CFG.AimEnabled then table.insert(active, "Nişan") end
            if CFG.KillAura then table.insert(active, "Alan") end
            if CFG.Noclip then table.insert(active, "Noclip") end
            if CFG.GodMode then table.insert(active, "Tanrı") end
            if CFG.AuraEnabled then table.insert(active, "Aura") end
            if CFG.Mevlana then table.insert(active, "Mevlana") end
            if CFG.FreeLook then table.insert(active, "FreeLook") end
            if CFG.Crosshair then table.insert(active, "Nişangah") end
            if CFG.Radar then table.insert(active, "Radar") end
            if CFG.ACBypass then table.insert(active, "AC-Bypass") end
            if CFG.NoFallDamage then table.insert(active, "DüşmeYok") end
            if #active > 0 then
                StatBar.Text = "> " .. table.concat(active, " + ")
                StatBar.TextColor3 = Color3.fromRGB(255, 200, 80)
            else
                StatBar.Text = "hazır"
                StatBar.TextColor3 = Color3.fromRGB(120, 220, 140)
            end
        end)
        task.wait(0.5)
    end
end)

task.spawn(function()
    while gui.Parent do
        if CFG.AutoSave then
            task.wait(CFG.AutoSaveInterval)
            pcall(function() Save() end)
        else
            task.wait(5)
        end
    end
end)

LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    if CFG.GodMode then
        local hum = GetHum(char)
        if hum then
            hum.MaxHealth = math.huge
            hum.Health = math.huge
        end
    end
    if CFG.InvisibleBody then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.Transparency = 1
            elseif p:IsA("Decal") then p.Transparency = 1 end
        end
    end
    if CFG.NoFallDamage then
        local hum = GetHum(char)
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        end
    end
    if CFG.SkinCurrentShirt ~= "" then task.wait(1) ApplyShirt(CFG.SkinCurrentShirt) end
    if CFG.SkinCurrentPants ~= "" then task.wait(1) ApplyPants(CFG.SkinCurrentPants) end
    if CFG.SkinCurrentFace ~= "" then task.wait(1) ApplyFace(CFG.SkinCurrentFace) end
    if CFG.SkinCurrentHairIds ~= "" then task.wait(1) ApplyHair(CFG.SkinCurrentHairIds) end
end)

