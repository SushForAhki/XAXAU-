local function GetPlr(name)
    if not name or name == "" then return nil end
    local n = name:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():sub(1, #n) == n then return p end
        if p.DisplayName:lower():sub(1, #n) == n then return p end
    end
    return nil
end

local function Ray(origin, dir, len, ignore)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = ignore or { LocalPlayer.Character }
    params.IgnoreWater = true
    return Workspace:Raycast(origin, dir * len, params)
end

local function ColFromT(t)
    return Color3.fromRGB(t[1], t[2], t[3])
end

