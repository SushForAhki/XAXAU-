local function ScanNPCs()
    if not CFG.ESPNPC then
        for model, _ in pairs(NPCData) do RemoveNPCESP(model) end
        return
    end
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("Model") then
            local hum = v:FindFirstChildOfClass("Humanoid")
            if hum and not Players:GetPlayerFromCharacter(v) then
                if not NPCData[v] then BuildNPCESP(v) end
            end
        end
    end
    for model, _ in pairs(NPCData) do
        if not model.Parent or not model:FindFirstChildOfClass("Humanoid") then
            RemoveNPCESP(model)
        end
    end
end

local function MatchItemFilter(obj)
    if not CFG.ESPItemFilter or CFG.ESPItemFilter == "all" then return true end
    local name = obj.Name:lower()
    local parentName = obj.Parent and obj.Parent.Name:lower() or ""
    if CFG.ESPItemFilter == "tools" then
        return name:find("tool") or name:find("gun") or name:find("sword") or name:find("knife") or name:find("item") or name:find("pickup")
    elseif CFG.ESPItemFilter == "givers" then
        return parentName:find("giver") or name:find("giver") or name:find("pickup") or name:find("spawner")
    elseif CFG.ESPItemFilter == "custom" then
        if not CFG.ESPItemCustom or CFG.ESPItemCustom == "" then return false end
        return name:find(CFG.ESPItemCustom:lower()) ~= nil
    end
    return true
end

local function BuildItemESP(obj)
    if ItemData[obj] then return end
    local part
    if obj:IsA("BasePart") then
        part = obj
    elseif obj:IsA("Model") then
        part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
    end
    if not part then return end

    local data = { obj = obj, part = part }

    if HAS_DRAWING then
        data.box = {}
        for i = 1, 8 do
            data.box[i] = DrawingNew("Line", { Thickness = 1, Visible = false, Color = Color3.fromRGB(80, 255, 200) })
        end
        data.name = DrawingNew("Text", { Size = 11, Center = true, Outline = true, Visible = false, Color = Color3.fromRGB(80, 255, 200) })
        data.dist = DrawingNew("Text", { Size = 10, Center = true, Outline = true, Visible = false, Color = Color3.fromRGB(200, 255, 220) })
    end

    ItemData[obj] = data
end

local function RemoveItemESP(obj)
    local data = ItemData[obj]
    if not data then return end
    if data.box then
        for _, l in ipairs(data.box) do DrawingRemove(l) end
    end
    for _, key in ipairs({ "name", "dist" }) do
        DrawingRemove(data[key])
    end
    ItemData[obj] = nil
end

local function ScanItems()
    if not CFG.ESPItem then
        for obj, _ in pairs(ItemData) do RemoveItemESP(obj) end
        return
    end
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") or v:IsA("Model") then
            if v ~= LocalPlayer.Character and not v:IsDescendantOf(LocalPlayer.Character) then
                if not v:FindFirstChildOfClass("Humanoid") and MatchItemFilter(v) then
                    if not ItemData[v] then BuildItemESP(v) end
                end
            end
        end
    end
    for obj, _ in pairs(ItemData) do
        if not obj.Parent or not MatchItemFilter(obj) then RemoveItemESP(obj) end
    end
end

