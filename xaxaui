local function DrawingNew(typ, props)
    if not HAS_DRAWING then return nil end
    local obj
    pcall(function()
        obj = Drawing.new(typ)
        if props then
            for k, v in pairs(props) do obj[k] = v end
        end
    end)
    return obj
end

local function DrawingRemove(obj)
    if obj and obj.Remove then pcall(function() obj:Remove() end) end
end

