local ConsLogs = {}

local function ConsPrint(text, color)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -6, 0, 0)
    l.AutomaticSize = Enum.AutomaticSize.Y
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = color or Color3.fromRGB(180, 220, 180)
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Top
    l.TextWrapped = true
    l.Font = Enum.Font.Code
    l.TextSize = 10
    l.Parent = ConsFrame
    table.insert(ConsLogs, l)
    if #ConsLogs > 150 then
        local old = table.remove(ConsLogs, 1)
        if old and old.Parent then old:Destroy() end
    end
    ConsFrame.CanvasPosition = Vector2.new(0, ConsLayout.AbsoluteContentSize.Y)
end

local function ConsRun(code)
    if not code or code == "" then return end
    ConsPrint("> " .. code:sub(1, 80), Color3.fromRGB(150, 200, 255))
    local fn, err = loadstring(code, "XAXA_Konsol")
    if not fn then
        ConsPrint("SÖZDİZİMİ: " .. tostring(err), Color3.fromRGB(255, 100, 100))
        return
    end
    local ok, res = pcall(fn)
    if ok then
