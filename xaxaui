    local count = CFG.AuraCount
    for i = 1, count do
        local part = Instance.new("Part")
        part.Name = "AuraPart_" .. i
        part.Size = Vector3.new(0.3, 0.3, 0.3) * CFG.AuraSize
        part.Shape = Enum.PartType.Ball
        part.Material = Enum.Material.Neon
        part.CanCollide = false
        part.Anchored = true
        part.CastShadow = false
        part.Transparency = CFG.AuraTransparency
        part.Color = Color3.fromRGB(CFG.AuraColor[1], CFG.AuraColor[2], CFG.AuraColor[3])
        part.Parent = AuraFolder

        local light = Instance.new("PointLight")
        light.Color = part.Color
        light.Range = 6
        light.Brightness = 1.5
        light.Parent = part

        table.insert(AuraParts, {
            part = part,
            angle = (i / count) * math.pi * 2,
            heightOffset = math.random(-10, 10) / 10,
        })
    end
end

