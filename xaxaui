local function RemoveESP(p)
    local data = ESPData[p]
    if not data then return end
    if data.nameGui then pcall(function() data.nameGui:Destroy() end) end
    if data.boxOutline then
        for _, line in ipairs(data.boxOutline) do DrawingRemove(line) end
    end
    for _, key in ipairs({ "hpBg", "hpFill", "tracer", "dist", "hpText" }) do
        DrawingRemove(data[key])
    end
    ESPData[p] = nil
end

local function HideESP(data)
    if not data then return end
    if data.boxOutline then
        for _, line in ipairs(data.boxOutline) do
            if line then line.Visible = false end
        end
    end
    for _, key in ipairs({ "hpBg", "hpFill", "tracer", "dist", "hpText" }) do
        if data[key] then data[key].Visible = false end
    end
    if data.nameGui then data.nameGui.Enabled = false end
end

local function RefreshESP()
    if not CFG.ESP then
        for p, _ in pairs(ESPData) do HideESP(ESPData[p]) end
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not ESPData[p] then BuildESP(p) end
    end
    for p, _ in pairs(ESPData) do
        if not p.Parent or p == LocalPlayer then RemoveESP(p) end
    end
end

