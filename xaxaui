            FlyBG.P = 1200
            FlyBG.D = 60
            FlyBG.CFrame = hrp.CFrame
            FlyBG.Parent = hrp
        end
        local dir = Vector3.zero
        local cam = Camera.CFrame
        if KS.W then dir = dir + cam.LookVector end
        if KS.S then dir = dir - cam.LookVector end
        if KS.A then dir = dir - cam.RightVector end
        if KS.D then dir = dir + cam.RightVector end
        if KS.SP then dir = dir + Vector3.new(0, 1, 0) end
        if KS.LC then dir = dir - Vector3.new(0, 1, 0) end
