    btn.MouseEnter:Connect(function()
        if not page.Visible then btn.BackgroundColor3 = Color3.fromRGB(32, 24, 36) end
    end)
    btn.MouseLeave:Connect(function()
        if not page.Visible then btn.BackgroundColor3 = Color3.fromRGB(22, 18, 26) end
    end)
