local fallState = {
    wasFalling = false,
    targetY = 0,
    landing = false,
    preLandingSpeed = 0,
}

local function SmartFallDamage()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = GetHum(char)
    if not hrp or not hum then return end

    local vel = hrp.Velocity
    local isFalling = vel.Y < -10
    local isMovingFast = vel.Magnitude > 30

    if isFalling and isMovingFast then
        fallState.wasFalling = true
    end

    if fallState.wasFalling then
        local rayResult = Workspace:Raycast(hrp.Position, Vector3.new(0, -100, 0), (function()
            local p = RaycastParams.new()
            p.FilterType = Enum.RaycastFilterType.Exclude
            p.FilterDescendantsInstances = { char }
            return p
        end)())
        if rayResult then
            local groundDist = (hrp.Position - rayResult.Position).Magnitude
            if groundDist < 20 and vel.Y < -15 then
                local slowFactor = math.clamp(groundDist / 20, 0, 1)
                local newY = math.max(-15, vel.Y * (0.3 + slowFactor * 0.4))
                hrp.Velocity = Vector3.new(vel.X, newY, vel.Z)
            end
            if groundDist < 3 and vel.Y < -5 then
                hrp.Velocity = Vector3.new(vel.X * 0.5, -3, vel.Z * 0.5)
            end
        end
    end

    if hum.FloorMaterial ~= Enum.Material.Air then
        if fallState.wasFalling then
            task.wait(0.2)
            fallState.wasFalling = false
        end
    end
end

